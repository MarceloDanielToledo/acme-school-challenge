    <NoRecordsContent>
        <MudText>No se encontraron ordenes locales</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Cargando...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] {10,100,150,200}" RowsPerPageString="Registros por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
    </PagerContent>
