                            @if (!string.IsNullOrEmpty(context.Comments))
                            {
                                <MudAlert Severity="Severity.Info">@context.Comments</MudAlert>
                            }
                            <ViewCreateOrderItemsTable ReadOnly="true" CanManageItems="false" OrderItems="context.OrderItems" />
                            @if (context.LocalErrors.Count > 0)
                            {
                                @foreach (var error in context.LocalErrors)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true">@error</MudAlert>
                                }

                            }
                        </MudCardContent>
                        <MudCardActions />
                    </MudCard>
                </td>
            </MudTr>
        }

