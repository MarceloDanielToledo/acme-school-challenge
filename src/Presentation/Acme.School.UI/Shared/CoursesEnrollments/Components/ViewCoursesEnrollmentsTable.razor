        <MudTd>
            @if (context.ShowItems)
            {
                <MudIconButton Size="Size.Small" OnClick="@(() => ShowButtonPress(context))" Title="Ocultar productos" Icon="@Icons.Material.Filled.KeyboardArrowUp" />
            }
            else
            {
                <MudIconButton Size="Size.Small" OnClick="@(() => ShowButtonPress(context))" Title="Ver productos" Icon="@Icons.Material.Filled.KeyboardArrowDown" />
            }
        </MudTd>
